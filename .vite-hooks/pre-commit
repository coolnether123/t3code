merge_head=$(git rev-parse --git-path MERGE_HEAD)
if [ -f "$merge_head" ]; then
  python=$(command -v python || command -v python3)
  "$python" scripts/check-fork-merge.py || exit $?
  vp staged --diff="$(git rev-parse MERGE_HEAD)" --no-stash --concurrent 1
else
  vp staged --no-stash --concurrent 1
fi
